generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id                  String          @id @default(uuid())

  email               String          @unique
  password            String?
  googleId            String?         @unique

  firstName           String?
  lastName            String?
  phone               String?

  role                Role?

  profileImageUrl     String?
  bankAccountName     String? 
  accountNumber       String?
  bankCode            String?
  bankName            String?

  schoolId            String?

  accountId           String?

  invitationCode      String?
  invitedById         String?
  invitedAt           DateTime?
  invitationCreatedAt DateTime?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  parent              Parent?
  student             Student?
  teacher             Teacher?

  passwordResets      PasswordReset[]
  schemeOfWorks       SchemeOfWork[]

  account             Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  managedSchool       School? @relation("SchoolAdministrator")
  school              School? @relation("SchoolMembers", fields: [schoolId], references: [id], onDelete: SetNull)
  invitedBy           User? @relation("UserInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers        User[] @relation("UserInvitations")

  referredPayments      Payment[] @relation("UserReferredPayments")
  commissions           Commission[] @relation("UserCommissions")
}


model PasswordReset {
  id            String   @id @default(uuid())
  codeHash      String
  resetTokenHash String?
  expiresAt     DateTime
  verifiedAt    DateTime?
  usedAt        DateTime?
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  @@index([userId])
}


model Account {
  id                    String                @id @default(uuid())
  accountType           AccountType           @default(INDIVIDUAL)

  createdAt             DateTime              @default(now())

  users                 User[]
  students              Student[]

  payments              Payment[]
  subscriptions         Subscription[]
  subscriptionUsages    SubscriptionUsage[]
  unlockedVideoLessons  UnlockedVideoLesson[]
}


model School {
  id                    String       @id @default(uuid())
  userId                String?      @unique

  name                  String?
  schoolEmail           String?      @unique
  schoolPhoneContact    String?
  address               String?
  website               String?
  bankAccountName       String? 
  accountNumber         String?
  bankCode              String?
  bankName              String?


  subdomain             String?      @unique
  commissionRate        Decimal      @default(20.00) @db.Decimal(5, 2)

  status                SchoolStatus @default(PRE_REGISTERED)

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt


  user                 User? @relation("SchoolAdministrator", fields: [userId], references: [id], onDelete: SetNull)
  users                User[] @relation("SchoolMembers")

  students             Student[]
  teachers             Teacher[]
  schemeOfWorks        SchemeOfWork[]
}


model Teacher {
  id          String   @id @default(uuid())
  userId      String?   @unique
  schoolId    String?
  gender      String?
  teacherCode String?
  subject     String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Parent {
  id                    String    @id @default(uuid())

  phone                 String?
  firstName             String?
  lastName              String?
  profileImageUrl       String?

  profilePasswordHash   String?
  profileResetCodeHash  String?
  profileResetExpiresAt DateTime?
  profileResetAttempts  Int       @default(0)

  userId                String?   @unique
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  students              Student[]
}


model Student {
  id                       String    @id @default(uuid())

  firstName                String?
  lastName                 String?
  age                      Int?
  classLevel               String?
  gender                   String?
  category                 String?
  phone                   String?

  schoolAttended           String?
  studentImageUrl          String?

  profilePasswordHash      String?

  parentId                 String?
  classId                  String?
  userId                   String?   @unique
  accountId                String?

  schoolId                 String?

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  parent                   Parent? @relation(fields: [parentId], references: [id], onDelete: SetNull)
  account                  Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  school                   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  class                    Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
  user                     User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentSubjects          StudentSubject[]

  lessonContents           LessonNote[]
  tutorMemories            TutorMemory[]
  dailyChallengeProgresses DailyChallengeProgress[]
  millionaireAttempts      MillionaireAttempt[]
  lessonprogresses         StudentLessonProgress[]
  quizAttempts             QuizAttempt[]
  speedChallengeAttempts   SpeedChallengeAttempt[]

  studentAchievements      StudentAchievement[]
  studentProfile           StudentProfile?
  studentScores            StudentScore[]
  subjectRankings          SubjectRanking[]
  topicAnalytics           TopicAnalytics[]

  tutorConversations       TutorConversation[]
  tutorLessonProgresses    TutorLessonProgress[]
  tutorLessonSessions      TutorLessonSession[]

  tutorLearningInsights    TutorLearningInsight?
  tutorLearningProfiles    TutorLearningProfile?
  tutorPreferences         TutorPreference?
  tutorSessionSummaries    TutorSessionSummary[]
  tutorTopicProgresses     TutorTopicProgress[]
}


model StudentSubject {
  studentId String
  subjectId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([studentId, subjectId])
  @@index([subjectId])
}


model StudentProfile {
  id           String   @id @default(uuid())
  studentId    String   @unique
  xp           Int      @default(0)
  level        Int      @default(1)
  totalGames   Int      @default(0)
  totalWins    Int      @default(0)
  streak       Int      @default(0)
  highestScore Int      @default(0)
  totalCorrect Int      @default(0)
  totalWrong   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}


model OfflineTestSubmission {
  id              String   @id @default(uuid())
  studentId       String
  clientAttemptId String
  quizId          String?
  payloadHash     String
  result          Json
  createdAt       DateTime @default(now())

  @@unique([studentId, clientAttemptId])
  @@index([studentId])
}

model StudentScore {
  id                  String   @id @default(uuid())

  studentId           String
  subjectId           String
  termId              String

  testTotalCorrect    Int      @default(0)
  testTotalQuestions  Int      @default(0)
  testTotalScore      Float      @default(0)
  testCount           Int      @default(0)

  testLowestScore     Float    @default(0)
  testHighestScore    Float    @default(0)
  testAverageScore    Float    @default(0)

  testTopics          Json?
  noOfTopics          Int      @default(0)

  examTotalCorrect    Int      @default(0)
  examTotalQuestions  Int      @default(0)

  examTotalScore      Float    @default(0)
  examCount           Int      @default(0)

  examLowestScore     Float    @default(0)
  examHighestScore    Float    @default(0)
  examAverageScore    Float    @default(0)

  examTerms           Json?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject             Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  term                Term?     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, termId])
}


model LessonNote {
  id                    String   @id @default(cuid())

  studentId             String
  topicId               String

  content               String   @default("")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([studentId])
  @@unique([studentId, topicId])
}

model SchemeOfWork {
  id               String    @id @default(uuid())
  classLevel       String
  schemeOfWorkYear String
  noOfPages        Int
  fileLink         String
  processingStatus String    @default("PENDING")
  uploadedById     String?
  schoolId         String?
  createdAt        DateTime  @default(now())
  classes          Class[]
  school           School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  uploadedBy       User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  subjects         Subject[]
  terms            Term[]
  topics           Topic[]
}

model Subject {
  id                     String                  @id @default(uuid())
  name                   String
  schemeOfWorkId         String?
  createdAt              DateTime                @default(now())
  classSubjects          ClassSubject[]
  studentSubjects        StudentSubject[]
  millionaireAttempts    MillionaireAttempt[]
  speedChallengeAttempts SpeedChallengeAttempt[]
  studentScores          StudentScore[]
  schemeOfWork           SchemeOfWork?           @relation(fields: [schemeOfWorkId], references: [id], onDelete: SetNull)
  subjectRankings        SubjectRanking[]
  terms                  Term[]
  topics                 Topic[]
}

model Class {
  id              String           @id @default(uuid())
  name            String          @unique
  schemeOfWorkId  String?
  createdAt       DateTime         @default(now())
  SchemeOfWork    SchemeOfWork?    @relation(fields: [schemeOfWorkId], references: [id], onDelete: SetNull)
  classSubjects   ClassSubject[]
  students        Student[]
  subjectRankings SubjectRanking[]
  terms           Term[]
  topics          Topic[]
}

model ClassSubject {
  classId   String
  subjectId String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
}

model Term {
  id             String       @id @default(uuid())
  name           String
  position       Int?
  schemeOfWorkId String?
  classId        String
  subjectId      String
  createdAt      DateTime     @default(now())
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  schemeOfWork   SchemeOfWork? @relation(fields: [schemeOfWorkId], references: [id], onDelete: SetNull)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentScores      StudentScore[]
  topics         Topic[]
}

model Topic {
  id                        String                @id @default(uuid())
  week                      Int?
  title                     String
  status                    LessonStatus          @default(PENDING)
  currentStage              String?
  renderId                  String?
  renderBucket              String?
  renderStatus              String?
  renderProgress            Float?                @default(0)
  renderedVideoUrl          String?
  mediaConvertJobId         String?
  hlsUrl                    String?
  progress                  Int                   @default(0)
  lessonContents            String[]
  lessonPlan                Json?
  lessonObjectives          TopicObjective[]
  generatedScenes           Json?
  schemeOfWorkId            String?
  classId                   String
  subjectId                 String
  termId                    String
  objectiveGenerationStatus TopicObjectiveGenerationStatus @default(NOT_GENERATED)
  createdAt                 DateTime              @default(now())
  studentProgresses       StudentLessonProgress[]

  lessonProgresses        TutorLessonProgress[]
  quizzes                   Quiz[]
  class                   Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  schemeOfWork            SchemeOfWork?          @relation(fields: [schemeOfWorkId], references: [id], onDelete: SetNull)
  subject                 Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term                    Term                  @relation(fields: [termId], references: [id], onDelete: Cascade)
  analytics               TopicAnalytics[]
  unlockedAccounts        UnlockedVideoLesson[]
}


model TopicObjective {
  id          String   @id @default(uuid())

  topicId     String
  title       String
  description String?
  order       Int

  source      TopicObjectiveSource @default(AI_GENERATED)

  topic       Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  progress    TutorObjectiveProgress[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([topicId, order])
  @@index([topicId])
}

model SubjectRanking {
  id        String  @id @default(uuid())
  studentId String
  subjectId String?
  xp        Int     @default(0)
  level     Int     @default(1)
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId])
}

model DailyChallenge {
  id                       String                   @id @default(uuid())
  title                    String                   @unique
  description              String
  xpReward                 Int
  createdAt                DateTime                 @default(now())
  dailyChallengeProgresses DailyChallengeProgress[]
}

model DailyChallengeProgress {
  id          String         @id @default(uuid())
  challengeId String?
  studentId   String
  completed   Boolean        @default(false)
  challenge   DailyChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
}


model Quiz {
  id        String        @id @default(uuid())
  title     String
  topicId   String
  createdAt DateTime      @default(now())
  questions Question[]
  topic     Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts  QuizAttempt[]
}

model Question {
  id                String          @id @default(uuid())
  text              String
  correctAnswer     String
  explanation       String
  quizId            String
  options           String[]
  createdAt         DateTime        @default(now())
  quiz              Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentAnswers    StudentAnswer[]
}

model QuizAttempt {
  id        String          @id @default(uuid())
  studentId String
  quizId    String
  score     Int
  completed Boolean         @default(false)
  createdAt DateTime        @default(now())
  quiz      Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers   StudentAnswer[]
}

model StudentAnswer {
  id         String      @id @default(uuid())
  attemptId  String
  questionId String
  selected   String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model MillionaireAttempt {
  id           String   @id @default(uuid())
  studentId    String
  subjectId    String?
  score        Int
  levelReached Int
  correct      Int
  wrong        Int
  completed    Boolean
  createdAt    DateTime @default(now())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject      Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model SpeedChallengeAttempt {
  id         String   @id @default(uuid())
  studentId  String
  subjectId  String?
  score      Int
  correct    Int
  wrong      Int
  accuracy   Int?
  difficulty String
  timeSpent  Int?
  completed  Boolean  @default(true)
  createdAt  DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}


model StudentAchievement {
  id            String                @id @default(uuid())
  achievementId String
  studentId     String
  earnedAt      DateTime              @default(now())
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id])
  student       Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
}

model AchievementDefinition {
  id                  String               @id @default(uuid())
  code                String               @unique
  title               String
  description         String
  icon                String
  studentAchievements StudentAchievement[]
}


model TopicAnalytics {
  id                  String    @id @default(uuid())
  studentId           String
  topicId             String

  completionRate      Float     @default(0)
  averageScore        Float     @default(0)

  testCount           Int       @default(0)
  totalQuestions      Int       @default(0)
  totalCorrect        Int       @default(0)

  attemptedQuestionIds Json?

  lastScore           Float?
  highestScore        Float?
  lowestScore         Float?

  lastAccessed        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic               Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
}


model SubscriptionPlan {
  id                                  String  @id @default(uuid())
  subscriptionPlanName                SubscriptionPlanType      @unique
  pricePerTerm                        Decimal @db.Decimal(10, 2)
  pricePerSession                     Decimal?  @db.Decimal(10, 2)
  maxStudents                         Int
  videoLessonLimit                    Int?
  homeHelperLimit                     Int?
  canTakeTest                         Boolean @default(false)
  canPracticeForExam                  Boolean @default(false)
  canPracticeForQuiz                  Boolean @default(false)
  canSpeakWithTeacher                 Boolean @default(false)
  canChatWithLearningAssistant        Boolean @default(false)
  canPlayCardGame                     Boolean @default(false)
  canPlaySpeedChallange               Boolean @default(false)
  canPlayMillionaire                  Boolean @default(false)
  canPartakeInLeaderboardRanking      Boolean @default(false)

  canDownloadOfflineContent           Boolean @default(false)
  createdAt                           DateTime @default(now())

  subscriptions                 Subscription[]
  payments                      Payment[]
}


model Subscription {
  id                 String @id @default(uuid())

  accountId          String?  @unique
  subscriptionPlanId String?

  status             SubscriptionStatus
  duration           SubscriptionDuration

  startsAt           DateTime
  endsAt             DateTime?

  numberOfTerms      Int
  amountPaid         Decimal              @db.Decimal(10, 2)

  isLifetime         Boolean              @default(false)

  createdAt          DateTime             @default(now())

  account            Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)

  subscriptionPlan   SubscriptionPlan?    @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)

  payments            Payment[]
}


model Payment {
  id                       String               @id @default(uuid())

  accountId                String?
  referredByUserId         String?

  subscriptionId           String?
  subscriptionPlanId       String?

  reference                String               @unique

  paystackTransactionId    BigInt?              @unique
  flutterwaveTransactionId BigInt?              @unique

  amount                   Decimal              @db.Decimal(10, 2)
  numberOfTerms            Int?
  currency                 String

  provider                 PaymentProvider
  status                   PaymentStatus

  paidAt                   DateTime?
  createdAt                DateTime             @default(now())

  account                  Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)

  referredBy               User?                @relation("UserReferredPayments", fields: [referredByUserId], references: [id], onDelete: SetNull)

  subscription             Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionPlan         SubscriptionPlan?    @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  commission               Commission?
  paymentEvents            PaymentEvent[]

  @@index([accountId])
  @@index([referredByUserId])
  @@index([subscriptionId])
  @@index([subscriptionPlanId])
  @@index([status])
  @@index([provider])
}


model Commission {
  id                String              @id @default(uuid())

  referrerUserId    String

  paymentId         String              @unique

  referrerRole      Role

  percentage        Decimal             @db.Decimal(5, 2)

  paymentAmount     Decimal             @db.Decimal(10, 2)
  commissionAmount  Decimal             @db.Decimal(10, 2)
  currency          String              @default("NGN")

  status            CommissionStatus    @default(AVAILABLE)

  createdAt         DateTime             @default(now())
  paidAt            DateTime?

  referrer          User                @relation("UserCommissions", fields: [referrerUserId], references: [id], onDelete: Restrict)

  payment           Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([referrerUserId])
  @@index([status])
  @@index([createdAt])
}


model PaymentEvent {
  id          String          @id @default(uuid())

  provider    PaymentProvider
  eventId     String
  eventType   String

  paymentId   String?
  payload     Json?

  createdAt   DateTime        @default(now())
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([provider])
}


model SubscriptionUsage {
  id        String                   @id @default(uuid())
  accountId String
  feature   SubscriptionUsageFeature
  used      Int                      @default(0)
  resetAt   DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  account   Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, feature])
}


model UnlockedVideoLesson {
  id         String   @id @default(uuid())
  accountId  String
  topicId    String
  unlockedAt DateTime @default(now())
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([accountId, topicId])
  @@index([accountId])
  @@index([topicId])
}


model TutorConversation {
  id                    String               @id @default(uuid())
  studentId             String
  title                 String?

  mode                  TutorConversationMode @default(GENERAL)

  lessonProgress        TutorLessonProgress?
  lessonSession         TutorLessonSession?

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  student               Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages              TutorMessage[]
  tutorSessionSummaries TutorSessionSummary?

  @@index([studentId])
}


model TutorMessage {
  id              String             @id @default(uuid())
  conversationId  String
  lessonSessionId String?

  role            String
  content         String

  images          Json?
  audioSegments   Json?
  contentBlocks   Json?

  createdAt       DateTime           @default(now())

  conversation    TutorConversation  @relation( fields: [conversationId], references: [id], onDelete: Cascade)

  lessonSession   TutorLessonSession? @relation(fields: [lessonSessionId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([lessonSessionId])
}

model TutorMemory {
  id         String   @id @default(uuid())
  studentId  String
  key        String
  value      String
  importance Int      @default(1)
  category   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, key])
}

model TutorPreference {
  id        String   @id @default(uuid())
  studentId String   @unique
  tutorMode String?
  voiceId   String?
  gender    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}


model TutorSessionSummary {
  id             String            @id @default(uuid())
  conversationId String            @unique
  studentId      String
  summary        String
  createdAt      DateTime          @default(now())
  conversation   TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TutorTopicProgress {
  id            String    @id @default(uuid())
  studentId     String
  subject       String?
  topic         String
  masteryScore  Float     @default(0)
  strengths     Json?
  weaknesses    Json?
  lastStudiedAt DateTime?
  createdAt     DateTime  @default(now())
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, topic])
}

model TutorLearningProfile {
  id                        String   @id @default(uuid())
  studentId                 String   @unique
  preferredExplanationStyle String?
  preferredDifficulty       String?
  learningSpeed             String?
  lastUpdated               DateTime @updatedAt
  student                   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TutorLearningInsight {
  id                String   @id @default(uuid())
  studentId         String   @unique
  strongestSubject  String?
  weakestSubject    String?
  recommendedTopics String[]
  nextGoal          String?
  updatedAt         DateTime @updatedAt
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TutorLessonProgress {
  id                 String            @id @default(uuid())

  studentId          String
  topicId            String
  conversationId     String?           @unique

  status             TutorLessonStatus @default(NOT_STARTED)

  currentObjectiveId String?
  currentStep        Int               @default(0)

  progressPercent    Float             @default(0)

  startedAt          DateTime?
  lastAccessedAt     DateTime?
  completedAt        DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  topic              Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)

  conversation       TutorConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  objectiveProgress    TutorObjectiveProgress[]
  sessions           TutorLessonSession[]
  memory             TutorLessonMemory?

  @@unique([studentId, topicId])
  @@index([studentId])
  @@index([topicId])
}


model TutorObjectiveProgress {
  id              String   @id @default(uuid())

  lessonProgressId String
  objectiveId      String

  status           TutorObjectiveStatus @default(NOT_STARTED)

  attempts         Int      @default(0)
  correctAttempts  Int      @default(0)

  masteryScore     Float    @default(0)

  startedAt        DateTime?
  completedAt      DateTime?

  lessonProgress   TutorLessonProgress @relation(fields: [lessonProgressId], references: [id], onDelete: Cascade)
  objective        TopicObjective      @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([lessonProgressId, objectiveId])
  @@index([objectiveId])
}



model TutorLessonMemory {
  id                String   @id @default(uuid())

  lessonProgressId  String   @unique

  summary           String?

  strengths         Json?
  weaknesses        Json?
  misconceptions    Json?
  masteredConcepts  Json?
  pendingConcepts   Json?

  lastInteractionSummary String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lessonProgress    TutorLessonProgress @relation(fields: [lessonProgressId], references: [id], onDelete: Cascade)
}


model TutorLessonSession {
  id                  String   @id @default(uuid())

  studentId           String
  lessonProgressId    String
  conversationId      String   @unique

  startedAt           DateTime @default(now())
  endedAt             DateTime?

  durationSeconds     Int?

  startingObjectiveId String?
  endingObjectiveId   String?

  startingStep        Int?
  endingStep          Int?

  createdAt           DateTime @default(now())

  student             Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lessonProgress      TutorLessonProgress @relation(fields: [lessonProgressId], references: [id], onDelete: Cascade)

  conversation        TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  events              TutorLessonEvent[]

  messages            TutorMessage[]

  @@index([studentId])
  @@index([lessonProgressId])
}


model TutorLessonEvent {
  id          String   @id @default(uuid())

  sessionId   String

  type        TutorLessonEventType

  objectiveId String?
  step        Int?

  data        Json?

  createdAt   DateTime @default(now())

  session     TutorLessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([objectiveId])
}


model StudentLessonProgress {
  id        String  @id @default(uuid())
  studentId String
  topicId   String
  completed Boolean @default(false)
  timeSpent Int?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
}


